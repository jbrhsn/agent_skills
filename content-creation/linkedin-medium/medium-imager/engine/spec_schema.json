{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medium imager image spec",
  "type": "object",
  "required": ["meta", "images"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "theme": { "type": "string", "minLength": 1 },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subtitle": { "type": "string" },
            "photo": { "type": "string" },
            "ratio": { "enum": ["wide", "square", "16:9"], "default": "wide" }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": { "$ref": "#/definitions/image" }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "section_divider" },
            "label": { "type": "string" }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "stat_callout" },
            "value": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "context": { "type": "string" }
          },
          "required": ["type", "value", "label"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "quote_block" },
            "quote": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string" }
          },
          "required": ["type", "quote"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "comparison_table" },
            "title_left": { "type": "string", "minLength": 1 },
            "title_right": { "type": "string", "minLength": 1 },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "string" }
              },
              "minItems": 1
            }
          },
          "required": ["type", "title_left", "title_right", "rows"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "code_card" },
            "code": { "type": "string", "minLength": 1 },
            "language": { "type": "string" }
          },
          "required": ["type", "code"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "linear_flow" },
            "steps": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 2,
              "maxItems": 6
            }
          },
          "required": ["type", "steps"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "branch_2way" },
            "left_label": { "type": "string", "minLength": 1 },
            "right_label": { "type": "string", "minLength": 1 },
            "left_items": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "right_items": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          },
          "required": ["type", "left_label", "right_label", "left_items", "right_items"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "stage_cycle" },
            "stages": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 2,
              "maxItems": 4
            }
          },
          "required": ["type", "stages"],
          "additionalProperties": false
        }
      ]
    }
  }
}
