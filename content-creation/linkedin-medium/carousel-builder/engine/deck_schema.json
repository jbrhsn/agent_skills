{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Carousel deck spec",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "theme"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "format": { "enum": ["square", "portrait", "landscape"], "default": "portrait" },
        "theme": { "type": "string", "minLength": 1 },
        "footer": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/slide" }
    }
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "statEntry": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    },
    "slide": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "title", "comparison", "quote", "stat_grid",
            "numbered_phase", "process_loop", "list_steps", "cta"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "title" },
            "headline": { "type": "string", "minLength": 1 },
            "subheadline": { "type": "string" },
            "kicker": { "type": "string" }
          },
          "required": ["type", "headline"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "comparison" },
            "title_left": { "type": "string", "minLength": 1 },
            "title_right": { "type": "string", "minLength": 1 },
            "items_left": { "$ref": "#/definitions/stringList" },
            "items_right": { "$ref": "#/definitions/stringList" },
            "heading": { "type": "string" }
          },
          "required": ["type", "title_left", "title_right", "items_left", "items_right"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "quote" },
            "quote": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string" }
          },
          "required": ["type", "quote"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "stat_grid" },
            "heading": { "type": "string", "minLength": 1 },
            "primary": { "$ref": "#/definitions/statEntry" },
            "secondary": {
              "type": "array",
              "items": { "$ref": "#/definitions/statEntry" },
              "minItems": 1,
              "maxItems": 6
            }
          },
          "required": ["type", "heading", "primary"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "numbered_phase" },
            "number": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "icon": { "type": "string" },
            "callout_label": { "type": "string" },
            "callout_body": { "type": "string" }
          },
          "required": ["type", "number", "title", "body"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "process_loop" },
            "heading": { "type": "string", "minLength": 1 },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "detail": { "type": "string" }
                }
              },
              "minItems": 2,
              "maxItems": 4
            }
          },
          "required": ["type", "heading", "steps"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "list_steps" },
            "heading": { "type": "string", "minLength": 1 },
            "items": { "$ref": "#/definitions/stringList" },
            "style": { "enum": ["bullet", "check", "number"], "default": "check" }
          },
          "required": ["type", "heading", "items"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "cta" },
            "headline": { "type": "string", "minLength": 1 },
            "subtext": { "type": "string" },
            "action": { "type": "string" }
          },
          "required": ["type", "headline"],
          "additionalProperties": false
        }
      ]
    }
  }
}
